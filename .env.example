# Copie para `.env` e preencha o que for usar. Nenhuma destas variáveis é
# obrigatória: sem elas o site sobe funcionando, só sem analytics/endpoint.

# URL pública do site, sem barra final. Usada em canonical, Open Graph,
# JSON-LD e sitemap.xml. Sem ela essas URLs ficam relativas.
VITE_SITE_URL=https://nexusdevhub.com

# Endpoint que recebe os leads do formulário (Formspree, Resend, n8n, API
# própria...). Recebe POST JSON com name, company, contact, area, message,
# source e sentAt. Sem ele o formulário cai para e-mail/WhatsApp.
VITE_LEAD_ENDPOINT=

# Analytics (Umami). O script só é injetado no HTML quando as DUAS
# variáveis estiverem preenchidas.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ---------------------------------------------------------------------------
# Meta: Pixel (navegador) + Conversions API (servidor)
# ---------------------------------------------------------------------------

# Id do conjunto de dados / Pixel. NÃO é segredo: fica visível no HTML.
# Sem ele o Pixel não é carregado.
VITE_META_PIXEL_ID=2796414304068060
META_CAPI_DATASET_ID=2796414304068060

# SEGREDO. Token do Conversions API — só no servidor, nunca versionado e
# nunca com prefixo VITE_ (o que o colocaria dentro do bundle do navegador).
# Sem ele o relay responde normalmente e apenas ignora os eventos.
META_CAPI_ACCESS_TOKEN=

# Opcional: código de "Testar eventos" do Gerenciador de Eventos da Meta.
# Enquanto estiver preenchido, os eventos vão para a aba de teste.
META_CAPI_TEST_EVENT_CODE=

# Opcionais (padrões abaixo). Úteis para testes e para fixar a versão da API.
# META_CAPI_GRAPH_URL=https://graph.facebook.com
# META_CAPI_VERSION=v21.0

# Opcional: use se o relay não estiver no mesmo domínio do site.
# VITE_META_CAPI_ENDPOINT=/api/meta/capi
